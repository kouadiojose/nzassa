# ============ N'Zassa Business — variables d'environnement ============
# Copier vers .env et adapter. Ne JAMAIS commiter de vrais secrets.

# --- Général ---
NZASSA_ENV=development            # development | staging | production
NZASSA_DEBUG=true
NZASSA_API_URL=http://localhost:8000

# --- Base de données ---
DATABASE_URL=postgresql+asyncpg://nzassa:nzassa_dev@localhost:5432/nzassa
DATABASE_URL_TEST=postgresql+asyncpg://nzassa:nzassa_dev@localhost:5432/nzassa_test

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Sécurité ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
OTP_EXPIRE_MINUTES=10

# --- CORS ---
CORS_ORIGINS=http://localhost:4200,http://localhost:8080

# --- Stockage fichiers (compatible S3) ---
STORAGE_BACKEND=local             # local | s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT_URL=
S3_BUCKET=nzassa
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Emails ---
EMAIL_BACKEND=console             # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@nzassa.app

# --- Notifications push ---
FCM_CREDENTIALS_JSON=

# --- Observabilité ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Assistant IA ---
AI_PROVIDER=stub                  # stub | anthropic
AI_API_KEY=
